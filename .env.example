# Prowlarr -- how ROMarr finds releases
PROWLARR_URL=http://prowlarr:9696
PROWLARR_API_KEY=

# Your game library -- where finished ROMs land, and who to tell about them.
# LIBRARY_KIND is romm, gaseous, retrom or folder.
#
# `folder` needs no URL and no account -- just LIBRARY_PATH. Use it for
# Batocera, RetroPie, Recalbox, EmulationStation, ES-DE, EmuDeck, Pegasus,
# Lakka, muOS, ArkOS, LaunchBox, Playnite, Steam ROM Manager, or anything else
# that reads ROMs out of a directory.
# Use a DEDICATED account, not your admin one; a rescan is all this needs.
LIBRARY_KIND=romm
LIBRARY_URL=http://romm:8080
LIBRARY_USERNAME=romarr
LIBRARY_PASSWORD=
# Running in Docker? This is a path INSIDE the container, and the compose files
# use /roms -- set that here and mount your library there, or the two disagree
# and the library reads as "Not available". /mnt/roms below suits a bare-metal
# install, where it is a real host path.
LIBRARY_PATH=/mnt/roms

# The ROMM_* names these replaced are still read, so an older .env keeps
# working: ROMM_URL, ROMM_USERNAME, ROMM_PASSWORD, ROMM_LIBRARY.

# Download clients
QBITTORRENT_URL=http://qbittorrent:8080
QBITTORRENT_USER=
QBITTORRENT_PASS=

# Optional -- usenet
SABNZBD_URL=
SABNZBD_API_KEY=
NZBGET_URL=
NZBGET_USER=
NZBGET_PASS=

# What ROMarr labels its own downloads with, so they stay distinguishable in a
# client you also use for other things. Defaults to "romarr" for each. The
# category does not have to exist in the client beforehand.
# QBITTORRENT_CATEGORY=romarr
# SABNZBD_CATEGORY=romarr
# NZBGET_CATEGORY=romarr

# ROMarr itself
ROMARR_PORT=6868
LOG_LEVEL=INFO
# Docker only: run with the numeric owner/group used by the media stack.
# UMASK=002 makes new files 0664 and directories 0775. ROMarr never changes
# ownership or permissions on existing files mounted under /downloads.
# PUID=1000
# PGID=1000
# UMASK=002

# --- Authentication ---------------------------------------------------------
#
# ROMarr requires a credential by default. Leave everything below unset and the
# first person to open the web UI is asked to set a password -- that is the
# normal path, and after it the install is claimed and the screen becomes a
# sign-in.
#
# Set ROMARR_PASSWORD if you would rather claim the install before it ever
# serves a request, which is what a container template should do: there is then
# no window in which an unclaimed ROMarr is reachable.
# ROMARR_PASSWORD=choose-something-long

# The key for scripts and other *arrs. One is generated on first run and kept
# in ROMarr's data file; set this to pin it to a value you choose. Setting it
# also counts as claiming the install -- you hold a credential, so no setup
# screen is shown. Find a generated one under Settings -> General once signed
# in.
# ROMARR_API_KEY=

# Turns the gate off entirely. Only for an install already behind something
# that authenticates, and note it means *anything* reaching the port is in,
# including a request that bypassed the proxy. Prefer ROMARR_AUTH=forward.
# ROMARR_AUTH=disabled

# Single sign-on: keep the proxy as the authority, but verify the request
# actually came through it. ROMARR_TRUSTED_PROXIES is required -- without it
# anybody could send the identity header themselves.
# ROMARR_AUTH=forward
# ROMARR_SSO_PROVIDER=authentik
# ROMARR_TRUSTED_PROXIES=192.168.0.0/16
# ROMARR_SSO_USER_HEADER=X-Authentik-Username
# ROMARR_SSO_GROUPS_HEADER=X-Authentik-Groups
# ROMARR_SSO_GROUP=romarr-admins

# Nothing loads this file for you -- there is no dotenv dependency. Use it as a
# systemd EnvironmentFile, hand it to Docker as env_file, or source it:
#   set -a; . ./.env; set +a

# --- if this file is sitting next to docker-compose.yml --------------------
#
# Compose also reads `.env` for its own interpolation, and the compose file
# requires two names that ROMarr itself never sees. They are the HOST sides of
# the library and downloads mounts, and they have no default on purpose: Docker
# creates a missing bind-mount source, so a placeholder would produce a green
# install filing ROMs into a directory nothing scans. Compose refuses to start
# without them.
# ROMARR_ROMS=/mnt/roms
# ROMARR_DOWNLOADS=/mnt/downloads

# Optional headless RetroArch stream server. Read-only: ROMarr asks it which
# platforms it can play, and uses the answer to report PS2, GameCube, Wii,
# Dreamcast and 3DS as playable rather than download-only. Everything works
# without it, minus those routes.
# STREAM_SERVER_URL=http://romm-stream:8090

# Which browser players ROMarr offers, best first. All four unless you say
# otherwise; `none` turns every browser route off. An unset or empty value
# means all four, not none -- a blanked variable must not silently remove
# every play route.
#
#   emulatorjs  libretro cores in the browser. Your library server serves it.
#   ruffle      Flash `.swf`. Your library server serves it. Turn this off if
#               you run RomM with DISABLE_RUFFLE_RS, so ROMarr stops promising
#               a button that will not be there.
#   jsdos       DOS and Windows 9x. You host it; see ROMARR_JSDOS_URL.
#   emularity   Archive.org's own in-page emulator. Turn this off if you would
#               rather nobody was sent off your install to play something.
#
# ROMARR_PLAYERS=emulatorjs,ruffle,jsdos,emularity

# Where your own js-dos and Emularity live, if you run them. Without a URL
# those two players report that they *would* run a file and cannot be linked
# to -- which is the honest answer, and names the setting that fixes it.
# ROMARR_JSDOS_URL=https://dos.example.lan
# ROMARR_EMULARITY_URL=https://emularity.example.lan

# --- DAT verification -------------------------------------------------------
#
# Where your No-Intro / Redump DATs live. Both loose .dat/.xml files and the
# ZIP archives No-Intro distributes are read, including DATs one directory down
# beside the platform they describe. Point this at a DAT directory, NOT at your
# ROM library: a library walk is the whole library.
# DAT_PATH=/dats

# Compressatorium -- the service that decompresses a compressed library. Needed
# only for the Decompress task (batch decompress -> DAT verify -> delete
# originals). https://github.com/pacnpal/compressatorium
#
# Without it, everything else works and the Decompress task reports that it is
# not configured. The library directory must be mounted into BOTH containers at
# the same path, because ROMarr hands the service a path rather than a file.
# COMPRESSATORIUM_URL=http://compressatorium:8080
# COMPRESSATORIUM_API_KEY=

# Switch validation. Nintendo Switch has no No-Intro or Redump DAT, so ROMarr
# uses TitleDB (https://github.com/blawar/titledb) instead: every title ID, its
# kind (base game / DLC / update) and its version history, fetched from the
# catalogue's own JSON and cached under ROMARR_DATA/titledb.
#
# On by default at 1.7MB. TITLED_NAMES=1 additionally loads a region file with
# names, publishers and sizes -- 65-95MB, cached, but seconds of parse time and
# a few hundred MB of RAM, which is why it is opt-in.
# TITLED_NAMES=1
# TITLED_REGION=US.en
