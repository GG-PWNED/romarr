# Prowlarr -- how Romarr finds releases
PROWLARR_URL=http://192.168.0.115:9696
PROWLARR_API_KEY=

# RomM -- where finished ROMs land, and who to tell about them.
# Use a DEDICATED account, not your admin one; a rescan is all this needs.
ROMM_URL=https://romm.example.com
ROMM_USERNAME=romarr
ROMM_PASSWORD=
ROMM_LIBRARY=/mnt/roms

# Download clients
QBITTORRENT_URL=http://192.168.0.187:8080
QBITTORRENT_USER=
QBITTORRENT_PASS=

# Optional -- usenet
NZBGET_URL=
NZBGET_USER=
NZBGET_PASS=

# Romarr itself
ROMARR_PORT=7878
LOG_LEVEL=INFO
